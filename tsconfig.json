{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["ESNext", "DOM"],
    "removeComments": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "alwaysStrict": true,
    "types": ["chai", "jquery", "knockout", "lozad", "mocha"],
    "noUncheckedSideEffectImports": false
  },
  "files": [
    "src/videoload2.ts",
    "src/videoload2-story.ts",
    "src/videoload2-tool.ts",
    "test/videoload2-lazy.ts",
    "test/videoload2-spec.ts",
    "typings/index.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}