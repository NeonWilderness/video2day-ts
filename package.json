{
  "name": "video2day",
  "version": "2.12.4",
  "description": "Video/iframe generator for the Twoday blogging platform",
  "main": "video2day.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:NeonWilderness/video2day-ts.git"
  },
  "scripts": {
    "update": "ncu -u -x @types/jquery,del,eslint,typescript && npm i",
    "build": "gulp --production",
    "dev": "gulp",
    "copy": "gulp copy",
    "lint": "eslint . --quiet --ext .ts",
    "lint:fix": "eslint . --fix --quiet",
    "list": "node ./util/listcdn",
    "scripts:dev": "node ./util/uploadScripts --platform=dev",
    "scripts:prod": "node ./util/uploadScripts --platform=prod",
    "stories:dev": "node ./util/updateStories --platform=dev",
    "stories:prod": "node ./util/updateStories --platform=prod"
  },
  "keywords": [
    "video generator",
    "iframe generator",
    "Twoday"
  ],
  "author": "NeonWilderness",
  "license": "MIT",
  "dependencies": {
    "load-script2": "^2.0.6",
    "lozad": "^1.16.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@neonwilderness/twoday": "^0.9.2",
    "@types/chai": "^5.2.3",
    "@types/jquery": "^1.10.36",
    "@types/knockout": "^3.4.79",
    "@types/lozad": "^1.16.4",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "css-loader": "^7.1.4",
    "del": "^6.0.0",
    "dotenv-safe": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-webpack-plugin": "^6.0.0",
    "gulp": "^5.0.1",
    "gulp-pug": "^5.0.0",
    "less": "^4.9.0",
    "less-loader": "^13.0.0",
    "minimist": "^1.2.8",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.109.2"
  }
}
