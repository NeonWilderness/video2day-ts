{
  "name": "video2day",
  "version": "2.12.1",
  "description": "Video/iframe generator for the Twoday blogging platform",
  "main": "video2day.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:NeonWilderness/video2day-ts.git"
  },
  "scripts": {
    "update": "ncu -u -x @types/jquery,chalk,del,eslint,eslint-webpack-plugin && npm i",
    "build": "gulp --production",
    "dev": "gulp",
    "copy": "gulp copy",
    "lint": "eslint . --quiet --ext .ts",
    "list": "node ./util/listcdn",
    "scripts:dev": "node ./util/uploadScripts --platform=dev",
    "scripts:prod": "node ./util/uploadScripts --platform=prod",
    "stories:dev": "node ./util/updateStories --platform=dev",
    "stories:prod": "node ./util/updateStories --platform=prod"
  },
  "keywords": [
    "video generator",
    "iframe generator",
    "Twoday"
  ],
  "author": "NeonWilderness",
  "license": "MIT",
  "dependencies": {
    "load-script2": "^2.0.6",
    "lozad": "^1.16.0"
  },
  "devDependencies": {
    "@neonwilderness/twoday": "^0.5.7",
    "@types/chai": "^5.2.2",
    "@types/jquery": "^1.10.36",
    "@types/knockout": "^3.4.77",
    "@types/lozad": "^1.16.4",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "chai": "^5.2.1",
    "chalk": "^4.1.2",
    "css-loader": "^7.1.2",
    "del": "^6.0.0",
    "dotenv-safe": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-webpack-plugin": "^4.2.0",
    "gulp": "^5.0.1",
    "gulp-pug": "^5.0.0",
    "less": "^4.4.0",
    "less-loader": "^12.3.0",
    "minimist": "^1.2.8",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0"
  }
}
